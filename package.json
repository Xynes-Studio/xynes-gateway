{
  "name": "xynes-gateway",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bun": "1.3.4",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "4.0.15",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "4.0.15"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "scripts": {
    "dev": "sh -c 'bun --env-file=\"${XYNES_ENV_FILE:-.env.dev}\" run --watch src/index.ts'",
    "start": "sh -c 'bun --env-file=\"${XYNES_ENV_FILE:-.env.dev}\" run src/index.ts'",
    "test": "sh -c 'bun --env-file=\"${XYNES_ENV_FILE:-.env.dev}\" test'",
    "coverage": "sh -c 'bun --env-file=\"${XYNES_ENV_FILE:-.env.dev}\" test --coverage'",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "healthcheck": "bun -e 'const r=await fetch(`http://127.0.0.1:${process.env.PORT||4100}/health`);process.exit(r.ok?0:1)'"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "dotenv": "^17.4.2",
    "hono": "^4.13.8",
    "postgres": "^3.4.9",
    "posthog-node": "^5.52.4",
    "zod": "^4.6.5"
  }
}
